# Server process. supabase (default) queries Overture rows in Supabase.
# mock keeps the Austin generator for local verify only.
DATA_MODE=supabase

# Public Overture Maps release. Process pulls this into Supabase for selected hexes.
OVERTURE_RELEASE=2026-10-21.0

# Publishable anon key only. The Node server reads these. The browser never receives the key.
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are accepted as aliases.
# Never put the service-role key in this file or in Render.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Ingest guardrails. Defaults stay small so the Render free instance (512MB) does not OOM.
# Code never allows values above the hard caps.
WORKFLOW_MAX_BBOX_AREA_KM2=180
WORKFLOW_MAX_ROWS_PER_DATASET=8000
WORKFLOW_MAX_TOTAL_ROWS=20000

# Object storage roots for the workflow Spark job plan.
OVERTURE_SILVER_PREFIX=s3://worldpulse/overture-silver
WORKFLOW_OUTPUT_PREFIX=s3://worldpulse/workflows
WORKFLOW_METRICS_PREFIX=s3://worldpulse/workflow-metrics
