# Server process. supabase (default) queries Overture rows in Supabase.
# mock keeps the Austin generator for local verify only.
DATA_MODE=supabase

# Public Overture Maps release. Process pulls this into Supabase for selected hexes.
OVERTURE_RELEASE=2026-10-21.0

# Publishable anon key only. The Node server reads these for queries and accounts.
# The browser never receives the key. Auth cookies stay httpOnly on this origin.
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are accepted as aliases.
# Never put the service-role key in this file or in Render.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Ingest guardrails. Defaults stay small so the Render free instance (512MB) does not OOM.
# Code never allows values above the hard caps.
WORKFLOW_MAX_BBOX_AREA_KM2=180
WORKFLOW_MAX_ROWS_PER_DATASET=8000
WORKFLOW_MAX_TOTAL_ROWS=20000

# Object storage roots for the workflow Spark job plan.
OVERTURE_SILVER_PREFIX=s3://worldpulse/overture-silver
WORKFLOW_OUTPUT_PREFIX=s3://worldpulse/workflows
WORKFLOW_METRICS_PREFIX=s3://worldpulse/workflow-metrics

# Optional OpenAI orchestrator and ai_column enrichment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional per-feature overrides (fallback to OPENAI_MODEL and OPENAI_API_KEY).
OPENAI_QUOTE_MODEL=gpt-4o-mini
OPENAI_AI_COLUMN_MODEL=gpt-4o-mini
OPENAI_QUOTE_API_KEY=
OPENAI_AI_COLUMN_API_KEY=
# Explorer planner uses a stronger model than quote / ai_column. Without a key the agent uses its built-in heuristics.
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_AGENT_API_KEY=
# The agent processes at most this many new hexes per request (lower only, max 36), one hex per job.
AGENT_MAX_NEW_HEXES=36
# Place names resolve through Nominatim. A city named in the prompt is searched there; the map locality is only a fallback. Set AGENT_GEOCODER=off to disable lookups.
AGENT_GEOCODER=
AGENT_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Demo agentic ledger and quote controls (usd cents).
LEDGER_SEED_CENTS=5000
AGENT_ORCHESTRATOR_BASE_CENTS=5
AGENT_PROCESS_HEX_CENTS=25
AGENT_GEOFENCE_BASE_CENTS=10
AGENT_GEOFENCE_VERTEX_CENTS=1
AGENT_HAIL_DAY_HEX_CENTS=1
AGENT_AI_BOOL_ROW_CENTS=2
AGENT_AI_ENUM_ROW_CENTS=3
AGENT_AI_NUMBER_ROW_CENTS=4
AGENT_AI_TEXT_ROW_CENTS=6
AGENT_TIP_BPS=500
AI_COLUMN_ROW_CAP=200
